# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah meng-commit .env.local ke Git.

# --- TiDB Cloud (ambil dari tombol "Connect" di dashboard cluster) ---
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=ganti-dengan-password-anda
TIDB_DATABASE=smartgov

# --- Keamanan sesi ---
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# --- Hanya untuk perintah: npm run db:seed-admin ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@contoh.go.id
ADMIN_PASSWORD=

# --- Email (opsional, untuk reset kata sandi dan verifikasi) ---
# Buat API key di https://resend.com. Tanpa ini email tidak terkirim (hanya dicatat di log).
RESEND_API_KEY=
# Pengirim. Untuk uji coba biarkan kosong; untuk produksi pakai domain yang sudah diverifikasi di Resend.
MAIL_FROM=
# URL publik situs, mis. https://smartgovconnect.vercel.app (dipakai pada tautan di email)
APP_URL=
