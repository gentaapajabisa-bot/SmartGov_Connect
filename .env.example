# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah meng-commit .env.local ke Git.

# --- TiDB Cloud (ambil dari tombol "Connect" di dashboard cluster) ---
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=ganti-dengan-password-anda
TIDB_DATABASE=smartgov

# --- Keamanan sesi ---
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# --- Hanya untuk perintah: npm run db:seed-admin ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@contoh.go.id
ADMIN_PASSWORD=
